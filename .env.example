APP_URL="http://localhost:3000"
PORT=3000

# Obtain from your Paystack dashboard. Use sk_test_ for provider test payments.
# Hosted checkout needs only the secret key, which must remain on the server.
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
# Explicit local simulation only; always rejected when NODE_ENV=production.
PAYSTACK_SANDBOX=false

ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=""

# Optional persistent directory for db.sqlite on a single-server deployment.
# DATA_DIR="/path/to/persistent/hideout-data"
